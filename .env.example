# Bot token, can be obtained from https://t.me/botfather
BOT_TOKEN=1234567890:AaBbCcDdEeFGgHhIiJjKkLlMmNnOoPpQq

# ID of the chat where messages will arrive. Can also be a group or a channel,
# in which case all members of the group/channel will be able to reply to messages.
# To find out the group ID, add the @my_id_bot bot to it — it will send the ID upon adding.
# To find out the channel ID, forward any message from it to the @my_id_bot bot.
# Note that group and channel IDs are negative (with a minus sign at the beginning),
# so you must also specify them with the minus sign! For example, -987654321
ADMIN_CHAT_ID=987654321

# Whether to delete the "message sent" confirmation shown to users.
# "yes", "1" or "true" (without quotes)
# REMOVE_SENT_CONFIRMATION=yes

# Debug mode: true → polling (for development), false → webhook (for production)
# "yes", "1" or "true" (without quotes)
# DEBUG=false

# --- Settings for webhook mode (DEBUG=false) ---

# Main domain for setting up the webhook
# WEBHOOK_DOMAIN=feedbackbot.example.com

# Path to the webhook URL on the domain
# WEBHOOK_PATH=/extra/path/from/root

# IP address of the interface to run the bot on. 0.0.0.0 == on all interfaces
# APP_HOST=0.0.0.0

# Port of the interface to run the bot on
# APP_PORT=9000

# Address of a custom Bot API server (optional)
# A non-empty value enables the local mode
# CUSTOM_BOT_API = http://127.0.0.1:8081

# SOCKS5 proxy for connecting to Telegram (optional)
# Used in debug mode (polling), e.g. socks5://127.0.0.1:1993
# PROXY=socks5://127.0.0.1:1080